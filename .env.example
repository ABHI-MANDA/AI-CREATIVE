# Local development. Never commit real secrets.
APP_NAME=AI Creative Studio
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=0

# Production persistence (leave DATABASE_URL empty locally to use JSON files)
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Supabase Storage (optional locally)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=creative-assets
SUPABASE_STORAGE_PUBLIC=0
STORAGE_TIMEOUT=120

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
# Free text-to-image; does not accept reference images.
OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design
# No free OpenRouter video model; leave blank to use the local renderer.
OPENROUTER_VIDEO_MODEL=

# Agnes AI
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# Creative defaults
DEFAULT_IMAGE_SIZE=1024x1024
VIDEO_SECONDS=6
VIDEO_FPS=24
REQUEST_TIMEOUT=180
VIDEO_POLL_SECONDS=5
VIDEO_TIMEOUT=900
SCRAPE_TIMEOUT=30
MAX_REFERENCE_IMAGES=12
MAX_REFERENCE_VIDEOS=5
MAX_VIDEO_FRAMES=6
MAX_DOWNLOAD_MB=80
MAX_UPLOAD_MB=80
