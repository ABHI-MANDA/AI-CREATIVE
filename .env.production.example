# Core
APP_NAME=AI Creative Studio
ENVIRONMENT=production
HOST=0.0.0.0
PORT=10000
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=1

# PostgreSQL / Supabase: use a pooled PostgreSQL connection string for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DO_NOT_COMMIT_THIS
SUPABASE_STORAGE_BUCKET=creative-assets
SUPABASE_STORAGE_PUBLIC=0
STORAGE_TIMEOUT=120

# AI providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free OpenRouter defaults.
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design
# No free OpenRouter video model; blank uses the local renderer.
OPENROUTER_VIDEO_MODEL=
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
